# Jarvis — ortam değişkenleri ŞABLONU.
#
# Kullanmak için:  cp .env.example .env
#
# TÜM ayarlar tek bir yerden, `app/config/settings.py` içindeki `Settings`
# sınıfından gelir. Değişkenler `JARVIS_` önekiyle okunur; önek olmadan
# yazılan bir satır SESSİZCE yok sayılır (ör. `ELEVENLABS_API_KEY` değil
# `JARVIS_ELEVENLABS_API_KEY`). Liste değerleri JSON olarak verilir:
#   JARVIS_TERMINAL_ALLOWED_COMMANDS=["pytest","git"]
#
# Bu dosya EKSİKSİZDİR: Settings'teki her alan burada geçer. Sır içermez;
# gerçek değerleri `.env` dosyasına yazın (o dosya git'e girmez). Zorunlu
# alan YOKTUR — hepsinin güvenli bir varsayılanı vardır.

# =====================================================================
# Uygulama
# =====================================================================
JARVIS_APP_NAME=Jarvis Local
JARVIS_APP_VERSION=0.1.0
# development | test | staging | production
JARVIS_ENVIRONMENT=development

# HTTP sunucusu
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# =====================================================================
# Loglar ve gözlemlenebilirlik
# =====================================================================
# DEBUG | INFO | WARNING | ERROR | CRITICAL
JARVIS_LOG_LEVEL=INFO
# json: her satır bir JSON nesnesi (üretim, makine tüketimi).
# text: insan tarafından okunabilir tek satır (yerel geliştirme).
JARVIS_LOG_FORMAT=json

# Her isteğe bir X-Request-ID atanır ve o istekteki tüm log satırlarına
# iliştirilir; istemci kendi kimliğini gönderirse korunur. Ayrı bir ayarı
# yoktur, davranış her zaman açıktır. İstek kimliği yanıt başlığında döner.

# =====================================================================
# Text Brain — Ollama
# =====================================================================
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Yerel olarak indirdiğiniz modelin adı. Örnek: gemma3
JARVIS_OLLAMA_MODEL=
JARVIS_OLLAMA_TIMEOUT_SECONDS=30

# İsteğe bağlı: varsayılan prompt yerine kullanılacak UTF-8 .txt dosyası.
# JARVIS_SYSTEM_PROMPT_FILE=C:\path\to\jarvis-system-prompt.txt

# Konuşma bağlamına dahil edilecek en fazla mesaj sayısı (system hariç).
# 0 (veya negatif) sınırı devre dışı bırakır.
JARVIS_CONVERSATION_CONTEXT_LIMIT=40

# =====================================================================
# Depolama
# =====================================================================
# Kalıcı bellek veritabanı. Boş bırakılırsa platforma özgü kullanıcı veri
# dizini kullanılır (Windows: %LOCALAPPDATA%\Jarvis, macOS:
# ~/Library/Application Support/Jarvis, Linux: ~/.local/share/jarvis).
# JARVIS_MEMORY_DB_PATH=

# Denetim kaydı veritabanı. Boşsa bellek veritabanının yanına yazılır.
# Kalıcıdır: ne yapıldığının izi yeniden başlatmayı atlatmalıdır.
# JARVIS_AUDIT_DB_PATH=

# Konuşma geçmişi kalıcılığı. Kapatılırsa geçmiş RAM'de tutulur ve yeniden
# başlatmada silinir.
JARVIS_CONVERSATION_PERSISTENCE=true

# =====================================================================
# Ajan karar katmanı
# =====================================================================
# rule_based: deterministik, LLM çağırmaz (varsayılan).
# llm: kararı LLM'e verdirir, çıktıyı deterministik doğrular.
JARVIS_AGENT_DECISION_POLICY=rule_based
# Karar katmanı sohbet akışına bağlansın mı?
JARVIS_AGENT_CHAT_INTEGRATION=true

# =====================================================================
# Kimlik doğrulama
# =====================================================================
# TÜM uçlar için anahtar (sağlık ucu hariç). Sunucu 127.0.0.1 dışına
# bağlıysa ZORUNLUDUR; anahtarsız her istek reddedilir. Yerelde boş
# bırakılabilir.
# JARVIS_API_TOKEN=uzun-ve-rastgele-bir-deger

# Yönetim uçları için anahtar. Boşsa yönetim uçları YALNIZCA sunucu yerel
# adrese bağlıyken çalışır. `JARVIS_API_TOKEN`'dan AYRIDIR: biri "bu
# sunucuya erişebilir misin", diğeri "sağlayıcıyı değiştirebilir misin"
# sorusunu yanıtlar. Tanımlıysa isteklerde `X-Admin-Token` başlığı istenir.
# JARVIS_ADMIN_TOKEN=uzun-ve-rastgele-bir-deger

# =====================================================================
# Dosya ve terminal yetkileri (VARSAYILAN KAPALI)
# =====================================================================
# Ajanın dosya okuyabileceği çalışma kökü. BOŞ BIRAKILIRSA dosya araçları
# hiç kaydedilmez. Açık olsa bile her yazma kullanıcı onayından geçer.
# JARVIS_WORKSPACE_ROOT=C:\path\to\proje
JARVIS_WORKSPACE_WRITABLE=false

# Terminal. KAPALI varsayılan: açılmadıkça DANGEROUS izinli her araç
# reddedilir, kayıtlı olsa bile çalışamaz.
JARVIS_TERMINAL_ENABLED=false
# Çalıştırılmasına izin verilen program adları (JSON listesi). Boşsa
# inceleme/test araçlarından oluşan varsayılan küme kullanılır.
# JARVIS_TERMINAL_ALLOWED_COMMANDS=["pytest","git","ls"]
JARVIS_TERMINAL_TIMEOUT_SECONDS=60

# =====================================================================
# Notlar — kullanıcının ve ajanın paylaştığı kalıcı yüzey
# =====================================================================
# Açık olması ajanın notları OKUYABİLMESİ demektir; yazması ayrı karardır.
JARVIS_NOTES_ENABLED=true
JARVIS_NOTES_WRITABLE=true

# =====================================================================
# Araştırma (web erişimi) — VARSAYILAN KAPALI
# =====================================================================
# Açık olsa bile her getirme onaydan geçer ve özel ağ adresleri hiçbir
# koşulda getirilemez.
JARVIS_RESEARCH_ENABLED=false
# İzin verilen alan adları (JSON listesi). Boşsa özel ağ dışındaki her
# adres getirilebilir; liste verilirse yalnızca o alanlar ve alt alanları.
# JARVIS_RESEARCH_ALLOWED_DOMAINS=["docs.python.org"]
JARVIS_RESEARCH_TIMEOUT_SECONDS=20

# =====================================================================
# Kodlama döngüsü — anla → planla → uygula → doğrula → düzelt
# =====================================================================
# DÖRT ŞART BİRDEN gerekir; hiçbiri diğerinin yerine geçmez. Ajanın dosya
# değiştirip komut çalıştırdığı en yetkili yoldur, tek anahtarla açılmaz:
#   JARVIS_CODING_LOOP_ENABLED + JARVIS_WORKSPACE_ROOT +
#   JARVIS_WORKSPACE_WRITABLE + JARVIS_TERMINAL_ENABLED
JARVIS_CODING_LOOP_ENABLED=false
# Doğrulama başarısızsa denenecek düzeltme turu sayısı.
JARVIS_CODING_MAX_ITERATIONS=3
# Üretilen diff Council tarafından incelensin mi? Council kurulu değilse
# etkisizdir. İnceleme bir kapı DEĞİLDİR: bulgular sonucu değiştirmez.
JARVIS_CODING_REVIEW_ENABLED=true
# Doğrulama komutunun çalışabileceği en uzun süre (test paketi için
# terminal sınırından ayrı tutulur).
JARVIS_CODING_VERIFICATION_TIMEOUT_SECONDS=180
# Modelin seçebileceği doğrulama komutları (JSON listesi). Model bu listenin
# DIŞINA çıkamaz ve liste ayrıca komut politikasının tanıdıklarıyla süzülür.
# Boşsa yaygın test komutlarından oluşan varsayılan küme kullanılır.
# JARVIS_CODING_VERIFICATION_COMMANDS=["pytest -q"]

# =====================================================================
# Kullanıcı onayı
# =====================================================================
# Bir onay isteğinin geçerli kalma süresi (saniye).
JARVIS_APPROVAL_TTL_SECONDS=300
# Aynı anda bekleyebilecek en fazla onay isteği.
JARVIS_APPROVAL_MAX_PENDING=50

# =====================================================================
# Google Maps API
# =====================================================================
# Anahtar tanımlıysa geocode, yol tarifi ve yer arama araçları otomatik
# kaydedilir. Boşsa Maps araçları hiç var olmaz.
# console.cloud.google.com → Maps JavaScript API + Places API + Directions API
# JARVIS_MAPS_API_KEY=AIza...

# =====================================================================
# ElevenLabs seslendirme (TTS)
# =====================================================================
# Anahtar tanımlıysa /api/speech/* uçları açılır; boşsa uçlar 503 döner ve
# arayüz tarayıcının kendi ses motorunu kullanır.
# JARVIS_ELEVENLABS_API_KEY=
# Varsayılan ses kimliği (rastgele dize; insan okunur ad KABUL EDİLMEZ).
JARVIS_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Türkçe için çok dilli model. `eleven_turbo_v2_5` hızlıdır ama Türkçe
# telaffuzu bozuktur.
JARVIS_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
JARVIS_ELEVENLABS_TIMEOUT_SECONDS=30
# Seslendirilecek en uzun metin (karakter). Maliyet sınırıdır.
JARVIS_ELEVENLABS_MAX_CHARS=2500

# =====================================================================
# Eklentiler (plugin) — VARSAYILAN KAPALI
# =====================================================================
# Yeni araç/entegrasyonlar tek yerden eklentilerle eklenir. Bir eklentinin
# adı BURADA geçmedikçe KAPALIDIR; liste varsayılan olarak boştur. Kayıtlı
# eklentiler: context_tools, filesystem, notes, ui_actions, research,
# terminal, maps, example.
# Örnek: JARVIS_ENABLED_PLUGINS=["example"]
JARVIS_ENABLED_PLUGINS=[]

# =====================================================================
# Yetenek kaydı (çok kaynaklı araç sağlayıcıları)
# =====================================================================
# Yerleşik araçlar "builtin" sağlayıcısı olarak kayıtlıdır; yeni araç
# aileleri (MCP, Home Assistant, tarayıcı, bilgisayar kontrolü) aynı
# ToolProvider sözleşmesinden geçer. Kayıt çalışma zamanında rebuild()
# ile yeniden kurulabilir; uygulamayı yeniden başlatmak gerekmez.
#
# Araç başına aç/kapa ve izin override'ları SQLite'ta (tool_overrides
# tablosu) kalıcıdır ve yönetim panelinden yönetilir. İzin yükseltme
# serbest; düşürme yalnızca onayla ve denetim kaydıyla; DANGEROUS asla
# düşürülemez.
#
# Uçlar:
#   GET  /api/v1/capabilities          (salt-okunur; anahtar gerekmez)
#   GET  /api/admin/capabilities       (admin_token kuralına tabi)
#   PUT  /api/admin/capabilities/tools/{name}

# =====================================================================
# Agent Skills (SKILL.md) — VARSAYILAN AÇIK
# =====================================================================
# `skills/` altındaki her alt klasör, agentskills.io spesifikasyonuna göre
# bir yetenek olabilir: SKILL.md (YAML ön yüz + gövde) ve yanındaki
# referans/script dosyaları. Sistem prompt'una yalnızca ad ve açıklama
# girer (ilerici açıklama); gövde yalnızca `load_skill` aracıyla okunur.
#
# Skill'ler yalnızca OKUMA talimatları ve (terminal açıkken, onayla)
# script çalıştırma sunar; skill'ler için ayrı bir izin yolu yoktur.
# Yeni bir skill eklemek için klasörü `skills/` altına kopyalamanız yeter.
# Ayrıntılar: docs/skills.md
JARVIS_SKILLS_ENABLED=true
# Skill klasörlerinin arandığı yollar (JSON listesi; sıra korunur).
JARVIS_SKILLS_DIRS=["skills"]

# =====================================================================
# LLM Council (çok modelli müzakere) — VARSAYILAN KAPALI
# =====================================================================
# Tur başına N+N+1 LLM çağrısı demektir; açıkça seçilmelidir.
JARVIS_COUNCIL_ENABLED=false
# Üye model adları (JSON listesi). Her ad için ayrı sağlayıcı kurulur.
# JARVIS_COUNCIL_MODELS=["llama3.1","qwen2.5","mistral"]
# Sentezi üretecek model. Boşsa ilk üye kullanılır.
# JARVIS_COUNCIL_CHAIRMAN_MODEL=
JARVIS_COUNCIL_MAX_MEMBERS=4
JARVIS_COUNCIL_MIN_CANDIDATES=2
JARVIS_COUNCIL_REVIEW_ENABLED=true
JARVIS_COUNCIL_MEMBER_TIMEOUT_SECONDS=60
JARVIS_COUNCIL_TOTAL_TIMEOUT_SECONDS=180
JARVIS_COUNCIL_MAX_CONCURRENCY=3
# Prompt'a gömülürken uygulanan kısaltma sınırları (yalnızca model üretimi
# metinlere; kullanıcının isteği asla kısaltılmaz).
JARVIS_COUNCIL_MAX_CANDIDATE_CHARS=4000
JARVIS_COUNCIL_MAX_REVIEW_CHARS=2000

# =====================================================================
# Kabuk (derlenmiş frontend) ve yerelleştirme
# =====================================================================
# Derlenmiş kabuğun bulunduğu klasör. Varsa backend onu `/` altından sunar;
# yoksa uygulama yalnızca API sunar (bu bir hata değildir).
# Derleyici Create React App + craco'dur ve çıktısı `frontend/build`'tir.
JARVIS_FRONTEND_DIR=frontend/build

# Saat dilimi (IANA). Boşsa sunucunun yerel dilimi kullanılır; bulutta bu
# yanlış olur. Araçlar kullandıkları dilimi sonuçta bildirir.
# JARVIS_TIMEZONE=Europe/Istanbul
