# Frontend ortam değişkenleri — ÖRNEK. Gerçek değerleri buraya YAZMAYIN.
# Kullanmak için: cp .env.example .env

# Backend'in adresi.
#
# BOŞ BIRAKIN eğer backend derlenmiş kabuğu kendisi sunuyorsa ya da
# geliştirmede craco proxy'si kullanılıyorsa — ikisinde de tarayıcı için
# tek bir origin vardır ve CORS'a hiç gerek kalmaz.
#
# Yalnızca backend BAŞKA bir makinedeyse doldurun (ör. tabletten PC'ye):
#   REACT_APP_BACKEND_URL=http://192.168.1.42:8000
REACT_APP_BACKEND_URL=

# `npm start` sırasında /api isteklerinin proxy'leneceği adres.
# Backend'i farklı bir portta çalıştırıyorsanız değiştirin.
JARVIS_BACKEND_ORIGIN=http://127.0.0.1:8000

# NOT: Sağlayıcı anahtarları (Anthropic, Google Maps, ...) BURAYA GİRMEZ.
# Onlar sunucuda durur; frontend anahtarı hiç görmez, yalnızca
# "tanımlı mı" bilgisini alır. Buraya yazılan her şey derlenmiş
# JavaScript'in içine gömülür ve tarayıcıdan okunabilir.
