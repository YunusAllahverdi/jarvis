{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jarvis-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "--prefix",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "jarvis-backend",
      "runtimeExecutable": "../../../.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8123"
      ],
      "port": 8123,
      "autoPort": false
    }
  ]
}
